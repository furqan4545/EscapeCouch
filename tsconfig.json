{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["engine/**/*.ts", "pose/**/*.ts", "render/**/*.ts", "render/**/*.tsx", "ios-app/scripts/**/*.ts"]
}
